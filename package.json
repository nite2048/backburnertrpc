{
     "name": "backburner",
     "module": "index.ts",
     "type": "module",
     "private": true,
     
     "scripts": {
          "server": "bun --hot services/backend",
          "client": "bun --hot --cwd services/frontend dev",

          "generate": "bunx --bun drizzle-kit generate --config=drizzle-dev.config.ts",
          "migrate": "bunx --bun drizzle-kit migrate --config=drizzle-dev.config.ts",
          "push": "bunx --bun drizzle-kit push --config=drizzle-dev.config.ts",
          "studio": "bunx --bun drizzle-kit studio --config=drizzle-dev.config.ts",
          "check": "bunx --bun drizzle-kit check --config=drizzle-dev.config.ts",
          
          "todos": "bun run report.ts --exit-nicely > assets/todo.md"
     },
     
     "workspaces": [
          "services/*",
          "links/*"
     ],
     
     "devDependencies": {
          "@types/bun": "^1.3.14",
          "drizzle-kit": "^1.0.0-rc.4"
     },
     
     "peerDependencies": {
          "typescript": "^6.0.3"
     }
}
