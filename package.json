{
     "name": "backburner",
     "module": "index.ts",
     "type": "module",
     "private": true,

     "scripts": {
          "server": "bun --hot services/backend",
          "client": "bun --hot --cwd services/frontend dev",
          "todos": "bun run report.ts --exit-nicely > assets/todo.md"
     },

     "workspaces": [
          "services/*",
          "links/*"
     ],

     "devDependencies": {
          "@types/bun": "^1.3.14"
     },

     "peerDependencies": {
          "typescript": "^6.0.3"
     }
}
